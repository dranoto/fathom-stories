# --- Database ---
# Path is container-relative. Production bind-mounts the authoritative absolute host data path at /app/data.
DATABASE_URL=sqlite:///./data/stories.db

# --- LLM (OpenAI-compatible; Gemini is NOT supported) ---
# Swap any of these to point at a different provider/model without rebuilding the image.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_SUMMARY_MODEL_NAME=FreeOnly
DEFAULT_GROUPING_MODEL_NAME=FreeOnly
DEFAULT_CHAT_MODEL_NAME=FreeOnly
# Cap on tokens the summary LLM can emit per call. Reasoning models spend this
# budget on both hidden thinking and the final JSON, so keep substantial headroom.
SUMMARY_MAX_OUTPUT_TOKENS=16384
GROUPING_MAX_OUTPUT_TOKENS=8192
CHAT_MAX_OUTPUT_TOKENS=8192
# Optional compatibility fallback for all lanes. Prefer the lane-specific values.
LLM_REASONING_EFFORT=
# Grouping must emit compact JSON reliably; summaries benefit from deliberate thought.
SUMMARY_REASONING_EFFORT=medium
GROUPING_REASONING_EFFORT=none
CHAT_REASONING_EFFORT=

# --- Jev live article classifier (OpenCode Zen SystemOne) ---
# When enabled, each new article is classified against existing events in one
# bounded decision call. The full grouping LLM remains responsible for periodic
# regrouping and new-event creation from the ungrouped pool.
JEV_ENABLED=false
OPENCODE_ZEN_API_KEY=
JEV_ENDPOINT=https://opencode.ai/zen/v1/systemone
JEV_MODEL=jev-1.13
JEV_TIMEOUT_SECONDS=10
JEV_MIN_CONFIDENCE=0.90
JEV_MAX_CONCURRENCY=8
# Includes active and cooling events, newest first. One extra "none" option is added.
JEV_MAX_EVENT_CANDIDATES=80
# UTF-8 byte ceiling; 28k is a conservative upper bound for Jev's 32k-token context.
# Candidate events are relevance-ranked and trimmed until the serialized request fits.
JEV_MAX_REQUEST_BYTES=28000
# Open the in-memory circuit after this many consecutive provider failures.
JEV_FAILURE_THRESHOLD=8
JEV_CIRCUIT_COOLDOWN_SECONDS=300
# Classification-phase deadline; assignment writes and queued summary work occur afterward.
JEV_BATCH_TIMEOUT_SECONDS=120

SUMMARY_LLM_TEMPERATURE=0.2
GROUPING_LLM_TEMPERATURE=0.1
CHAT_LLM_TEMPERATURE=0.85
# HTTP request timeout (seconds) for each LLM client.
SUMMARY_REQUEST_TIMEOUT=300
GROUPING_REQUEST_TIMEOUT=180
CHAT_REQUEST_TIMEOUT=180
# Cap on the input prompt size for generate_initial_summary. Articles are taken
# most-recent-first, walking backwards until the next article would exceed this
# token budget (chars*4). 100k is comfortably within the limits of most providers.
SUMMARY_MAX_PROMPT_TOKENS=100000
CHAT_CONTEXT_MAX_ARTICLES=20
CHAT_CONTEXT_PER_ARTICLE_CHARS=3000
CHAT_MAX_TOOL_ITERATIONS=4
CHAT_TOOL_TIMEOUT_SECONDS=30
# Optional: list of MCP servers (streamable_http / sse / stdio) the chat LLM can call.
# Format: JSON list of {name, url, transport?, headers?, timeout?}.
# Example: CHAT_MCP_SERVERS=[{"name":"web_search","url":"http://example.com/mcp"}]
# Leave empty (or blank) to disable tool calling.
CHAT_MCP_SERVERS=

# --- RSS Feeds (comma-separated or JSON list) ---
# Examples:
#   RSS_FEED_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml
#   RSS_FEED_URLS=["https://feeds.bbci.co.uk/news/world/rss.xml","https://rss.nytimes.com/services/xml/rss/nyt/World.xml"]
RSS_FEED_URLS=

# --- Scheduler ---
DEFAULT_RSS_FETCH_INTERVAL_MINUTES=60
LIVE_GROUPING_INTERVAL_MINUTES=60
# The regroup pass is more expensive and can create events; a personal deployment
# normally needs it only a few times per day.
REGROUP_INTERVAL_HOURS=6
# Coalesce repeated additions to the same event before generating one summary.
SUMMARY_DEBOUNCE_MINUTES=20
MAX_ARTICLES_PER_INDIVIDUAL_FEED=15
RECLUSTER_HOUR_UTC=3
LIFECYCLE_TICK_HOURS=1
AUTO_ARCHIVE_DAYS=7
ARCHIVE_REVIVE_WINDOW_DAYS=30
# Live grouping caps and batches to stay under provider context windows.
# LIVE_GROUP_WINDOW_HOURS:   only consider ungrouped articles published within this many hours.
# LIVE_GROUP_MAX_ARTICLES:   per-tick cap on ungrouped articles fed to the live LLM.
# LIVE_GROUP_BATCH_SIZE:     how many articles per individual LLM call within that tick.
# Articles older than LIVE_GROUP_WINDOW_HOURS are left untouched in the DB; they
# are not deleted. They are simply ignored by the live pass.
LIVE_GROUP_WINDOW_HOURS=24
LIVE_GROUP_MAX_ARTICLES=200
LIVE_GROUP_BATCH_SIZE=50
REGROUP_BATCH_SIZE=50

# --- Shaped-score ranking (server-side defaults; per-browser knobs in the menu override these) ---
# SCORE_NEW_EVENT_BOOST_HOURS: newly-created events get a multiplier that decays to 1× over this many hours.
# SCORE_NEW_EVENT_BOOST_MAX:   multiplier at creation; 1.0 = no boost.
# SCORE_READ_ALL_DEMOTION:     multiplier on score when article_count > 0 AND unread_count == 0; 1.0 = no effect.
SCORE_NEW_EVENT_BOOST_HOURS=6.0
SCORE_NEW_EVENT_BOOST_MAX=5.0
SCORE_READ_ALL_DEMOTION=0.3

# --- Scraper / Playwright ---
PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_PAGE_WAIT_MS=3000
SCRAPE_REQUEST_DELAY_SEC=1
USE_HEADLESS_BROWSER=True
# /app/scraper_assistant is populated by the Dockerfile; override only if you mount your own.
PATH_TO_EXTENSION=

# --- Ports (host-side port for the reader UI) ---
MAIN_PORT=8800

# --- Summary prompts (optional overrides) ---
# The defaults are defined in app/config.py and used by app/grouping/summarizer.py.
#   DEFAULT_MAJOR_SUMMARY_PROMPT       — used for the initial event-level summary
#                                          and for full regenerations.
#                                          Placeholders: {event_name}, {article_texts}.
#   DEFAULT_SUMMARY_INCREMENTAL_PROMPT — used when 1+ new articles join an existing
#                                          event and the prior summary is updated.
#                                          Placeholders: {event_name}, {new_count},
#                                          {new_article_texts}, {prior_summary_json}.
# Uncomment + set to override. Keep the {{ ... }} double-braces around the inner
# JSON skeleton (and escape any other literal { or } as {{ or }}) so .format()
# still works at call time. The first call to summarize/regenerate will use
# whatever value is here. Note: prompts are read on process start, so after
# editing .env you'll need to restart the container for the change to take effect.
#
# DEFAULT_MAJOR_SUMMARY_PROMPT=
# DEFAULT_SUMMARY_INCREMENTAL_PROMPT=

# --- Debug ---
DEBUG_LEVEL=standard